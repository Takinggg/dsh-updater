{
  "name": "dsh-updater",
  "version": "0.4.2",
  "private": false,
  "license": "MIT",
  "description": "One-click updates for DeepSeek Harness (DSH). Community plugin — incremental npm tarballs, backup, rollback. Not official DeepSeek software.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "updater",
    "npm",
    "self-hosted",
    "codex",
    "community-plugin"
  ],
  "homepage": "https://github.com/Takinggg/dsh-updater#readme",
  "bugs": {
    "url": "https://github.com/Takinggg/dsh-updater/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takinggg/dsh-updater.git"
  },
  "author": "Takinggg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.fr.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test lib/engine.test.js lib/resolve.test.js lib/tarball.test.js",
    "demo": "node scripts/demo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
